{
  "name": "Credence",
  "version": "2.0.0",
  "main": "dist-electron/main.js",
  "author": "Effervetech Company Ltd",
  "description": "This app is used to manage finances",
  "scripts": {
    "ng": "ng",
    "compile-electron": "tsc -p tsconfig.electron.json",
    "start": "tsc -p tsconfig.electron.json && electron-forge start",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "package": "tsc -p tsconfig.electron.json && electron-forge package",
    "make": "ng build && tsc -p tsconfig.electron.json && electron-forge make",
    "compile-electron:watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "serve-electron": "electron dist-electron/main.js",
    "dev:electron": "concurrently -k \"npm:compile-electron:watch\" \"nodemon\""
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^22.0.4",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.4",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/material-symbols-outlined": "^5.3.0",
    "apexcharts": "^5.16.0",
    "better-sqlite3": "^12.11.1",
    "electron-squirrel-startup": "^1.0.1",
    "ng-apexcharts": "^2.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.0",
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-wix": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "concurrently": "^10.0.3",
    "electron": "43.1.1",
    "jsdom": "^28.0.0",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "volta": {
    "node": "24.15.0"
  }
}
