# Neon database connection string (get from Neon console)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Shared API key — the desktop app sends this as Bearer token
# Generate a strong random key, e.g. 32+ hex chars
API_KEY=replace-with-a-strong-random-key

# JWT secret for member-facing auth (mobile app)
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-strong-jwt-secret

# OneSignal — push notifications (server-side only, never expose to clients)
# App ID: OneSignal dashboard > Settings > Keys & IDs
ONESIGNAL_APP_ID=replace-with-onesignal-app-id
# REST API key: OneSignal dashboard > Settings > Keys & IDs (server only)
ONESIGNAL_REST_API_KEY=replace-with-onesignal-rest-api-key

# Optional: secret that authorizes manual processor invocations
# (Vercel cron uses the x-vercel-cron header and needs no value).
# Falls back to API_KEY when unset.
NOTIFICATIONS_CRON_SECRET=replace-with-a-strong-random-key

# Optional: max delivery attempts per notification event before FAILED
# (defaults to 5)
NOTIFICATIONS_MAX_ATTEMPTS=5
