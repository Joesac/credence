{
  "name": "credence-cloud-api",
  "version": "1.0.0",
  "description": "Cloud sync API for Credence — Hono + Drizzle + Neon on Cloudflare Workers",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/dev-server.ts",
    "build": "tsc",
    "start": "tsx --env-file=.env src/dev-server.ts",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --config wrangler.prod.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "drizzle-orm": "^0.41.0",
    "hono": "^4.13.5",
    "jose": "^6.2.10",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.1",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.7",
    "wrangler": "^4.86.0"
  }
}
